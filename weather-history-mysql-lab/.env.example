MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=weather_history_lab

# 선택한 모드에서만 사용합니다. 실제 키는 .env에만 넣고 Git에 올리지 마세요.
HF_MODEL=Qwen/Qwen2.5-1.5B-Instruct
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
OPENAI_API_KEY=
# 기본 HF 모델은 코드에 검증한 revision이 고정되어 있습니다. 사용자 지정 모델에만 필요합니다.
# HF_REVISION=exact_commit_sha
